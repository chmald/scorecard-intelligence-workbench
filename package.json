{
  "name": "scorecard-intelligence-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node app/server.mjs",
    "samples": "node scripts/generate-samples.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "evaluate": "node scripts/evaluate.mjs",
    "check:docs": "python scripts/lint_doc_visuals.py --strict"
  },
  "dependencies": {
    "@azure/cosmos": "4.10.2",
    "@azure/identity": "4.14.1",
    "exceljs": "4.4.0",
    "jose": "6.2.17",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
