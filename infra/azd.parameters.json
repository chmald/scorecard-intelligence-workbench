{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "entraAudience": { "value": "${ENTRA_AUDIENCE}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID}" },
    "entraApiScope": { "value": "${ENTRA_API_SCOPE}" },
    "containerImage": { "value": "${CONTAINER_IMAGE=mcr.microsoft.com/dotnet/samples:aspnetapp}" },
    "cosmosDatabaseName": { "value": "${COSMOS_DATABASE=workbench}" },
    "cosmosContainerName": { "value": "${COSMOS_CONTAINER=state}" },
    "cosmosThroughput": { "value": "${COSMOS_THROUGHPUT=400}" },
    "logRetentionDays": { "value": "${LOG_RETENTION_DAYS=30}" },
    "deployContentUnderstanding": { "value": "${DEPLOY_CONTENT_UNDERSTANDING=true}" },
    "contentUnderstandingLocation": { "value": "${CONTENT_UNDERSTANDING_LOCATION=}" },
    "contentUnderstandingAnalyzerId": { "value": "${CONTENT_UNDERSTANDING_ANALYZER_ID=document_metrics}" },
    "contentUnderstandingCompletionModelName": { "value": "${CONTENT_UNDERSTANDING_COMPLETION_MODEL=gpt-5.2}" },
    "contentUnderstandingCompletionModelVersion": { "value": "${CONTENT_UNDERSTANDING_COMPLETION_MODEL_VERSION=2025-12-11}" },
    "contentUnderstandingCompletionDeploymentName": { "value": "${CONTENT_UNDERSTANDING_COMPLETION_DEPLOYMENT=document-completion}" },
    "contentUnderstandingCompletionDeploymentSku": { "value": "${CONTENT_UNDERSTANDING_COMPLETION_DEPLOYMENT_SKU=GlobalStandard}" },
    "contentUnderstandingCompletionCapacity": { "value": "${CONTENT_UNDERSTANDING_COMPLETION_CAPACITY=1}" },
    "contentUnderstandingEmbeddingModelName": { "value": "${CONTENT_UNDERSTANDING_EMBEDDING_MODEL=text-embedding-3-large}" },
    "contentUnderstandingEmbeddingModelVersion": { "value": "${CONTENT_UNDERSTANDING_EMBEDDING_MODEL_VERSION=1}" },
    "contentUnderstandingEmbeddingDeploymentName": { "value": "${CONTENT_UNDERSTANDING_EMBEDDING_DEPLOYMENT=document-embedding}" },
    "contentUnderstandingEmbeddingDeploymentSku": { "value": "${CONTENT_UNDERSTANDING_EMBEDDING_DEPLOYMENT_SKU=GlobalStandard}" },
    "contentUnderstandingEmbeddingCapacity": { "value": "${CONTENT_UNDERSTANDING_EMBEDDING_CAPACITY=1}" },
    "contentUnderstandingSetupPrincipalId": { "value": "${CONTENT_UNDERSTANDING_SETUP_PRINCIPAL_ID=}" },
    "contentUnderstandingSetupPrincipalType": { "value": "${CONTENT_UNDERSTANDING_SETUP_PRINCIPAL_TYPE=User}" },
    "deployOpenAI": { "value": "${DEPLOY_OPENAI=true}" },
    "openAILocation": { "value": "${AZURE_OPENAI_LOCATION=}" },
    "openAIModelName": { "value": "${AZURE_OPENAI_MODEL_NAME=gpt-5.2}" },
    "openAIModelVersion": { "value": "${AZURE_OPENAI_MODEL_VERSION=2025-12-11}" },
    "openAIDeploymentName": { "value": "${AZURE_OPENAI_DEPLOYMENT=answers}" },
    "openAIDeploymentSku": { "value": "${AZURE_OPENAI_DEPLOYMENT_SKU=GlobalStandard}" },
    "openAICapacity": { "value": "${AZURE_OPENAI_CAPACITY=1}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP=}" }
  }
}
